<?xml version="1.0" encoding="utf-8"?>
<!-- PATH: app/src/main/res/layout/item_ram_app.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/surface"
    android:paddingHorizontal="14dp" android:paddingVertical="12dp"
    android:layout_marginBottom="6dp">

    <!-- Top row: icon / name / ram / kill button -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <ImageView android:id="@+id/iv_ram_icon"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginEnd="12dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_ram_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="13sp"
                android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="2dp">
                <TextView android:id="@+id/tv_ram_state"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary" android:textSize="10sp"
                    android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tv_ram_private"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text_disabled" android:textSize="10sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- RAM usage + % -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/tv_ram_pss"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/accent_blue" android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView android:id="@+id/tv_ram_pct"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_disabled" android:textSize="10sp"/>
        </LinearLayout>

        <!-- Kill button -->
        <ImageView android:id="@+id/iv_kill_btn"
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@drawable/ic_kill" android:padding="4dp"
            android:background="@color/accent_red_surface"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- RAM bar -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="4dp"
        android:background="@color/divider" android:layout_marginTop="10dp">
        <View android:id="@+id/v_ram_bar_fill"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:background="@color/accent_blue"/>
    </FrameLayout>

</LinearLayout>