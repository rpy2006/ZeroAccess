<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/black">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Alerts" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_clear_alerts" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Clear All" android:textColor="@color/accent_blue" android:textSize="13sp" android:padding="8dp"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>
    <TextView android:id="@+id/tv_no_alerts" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No alerts yet.
Permission events will appear here."
        android:textColor="@color/text_secondary" android:textSize="14sp"
        android:gravity="center" android:padding="48dp" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_alerts"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingTop="8dp" android:clipToPadding="false"/>
</LinearLayout>